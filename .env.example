# Copy to .env and fill in. Never commit the real file.
#
# Server-side key. Never sent to the browser. Restrict it in the Cloud console to
# Places API (New) + Geocoding, and to this machine's IP once it is known.
GOOGLE_MAPS_API_KEY=

# Browser key for map tiles. This one IS served to the page -- it has to be -- so
# its protection is an HTTP-referrer restriction. Add the public hostname or the
# map renders blank while everything else works.
MAPS_BROWSER_KEY=
